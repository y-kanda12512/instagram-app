<div class="post">
  <div class="post__head">
    <div class="post__head-user-info">
      <div class="post__profile-image">
        <% if @post.user.profile.profile_image.attached? %>
          <%= image_tag @post.user.profile.profile_image %>
        <% else %>
          <%= image_tag "default-profile.png", alt: "デフォルトプロフィール画像" %>
        <% end %>
      </div>
      <div class="post__account-info">
        <span class="post__account-name"><%= @post.user.account_name %></span>
        <span class="post__account-time">
          <%= @post.posting_hour %>
        </span>
      </div>
    </div>
    <%= link_to	'編集', edit_post_path(@post), class:"post__edit-link" ,data: { turbo: false } %>
  </div>
  <div class="post__body">
    <div class="post__images">
      <% if @post.post_images.attached? %>
        <% @post.post_images.each do |post_image| %>
          <%= image_tag url_for(post_image), alt: "投稿画像", class: "post__image" %>
        <% end %>
      <% end %>
    </div>
    <div class="post__content">
      <div class="post__info">
        <div class="post__description"><%= @post.content %></div>
      </div>
    </div>
  </div>
</div>